{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Clipboard",
  "version": "0.1.0",
  "identifier": "dev.ucb.universal-clipboard.gui",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Universal Clipboard",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon-128.png"
    ]
  }
}
