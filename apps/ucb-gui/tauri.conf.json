{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Clipboard",
  "version": "0.1.0",
  "identifier": "dev.ucb.universal-clipboard",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Universal Clipboard",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ucb"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nathandalpatan/universal-clipboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRkRGRjhEMURCRjZERjcKUldUM2JiOGRqZi85VThwQXpFUW1nUmJ0dXVNVUtJQ3BHUGRqa0tuMXcvZy9hYWl3eW5mZGNXd0wK"
    }
  }
}
